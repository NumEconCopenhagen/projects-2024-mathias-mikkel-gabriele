    "\n",
    "# Firm problem\n",
    "def firm1(p1,par):\n",
    "    l1 = (p1*par.A*par.gamma)**(1/(1-par.gamma))\n",
    "    y1 = par.A*l1**par.gamma\n",
    "    pi1 = (1-par.gamma)/par.gamma*(p1*par.A*par.gamma)**(1/(1-par.gamma))\n",
    "    return l1,y1,pi1\n",
    "    \n",
    "def firm2(p2,par):\n",
    "    l2 = (p2*par.A*par.gamma)**(1/(1-par.gamma))\n",
    "    y2 = par.A*l2**par.gamma\n",
    "    pi2 = (1-par.gamma)/par.gamma*(p2*par.A*par.gamma)**(1/(1-par.gamma))\n",
    "    return l2,y2,pi2\n",
    "\n",
    "# Consumer problem\n",
    "def optimal_c1(l,p1,pi,par):\n",
    "    return par.alpha*(l+par.T+pi)/p1\n",
    "\n",
    "def optimal_c2(l,p2,pi,par):\n",
    "    return (1-par.alpha)*(l+par.T+pi)/(p2+par.tau)\n",
    "\n",
    "def optimal_l(p1,p2,pi,par):\n",
    "    obj = lambda l: -np.log(optimal_c1(l,p1,pi,par)**par.alpha*optimal_c2(l,pi,p2,par)**(1-par.alpha))-par.nu*(l**(1+par.epsilon)/1+par.epsilon)\n",
    "    res = sp.optimize.minimize_scalar(obj,bounds=(0,1),method=\"bounded\")\n",
    "    l_star = res.x\n",
    "    c1_star = optimal_c1(l_star, p1, pi, par)\n",
    "    c2_star = optimal_c2(l_star, p2, pi, par)\n",
    "    return l_star, c1_star, c2_star\n",
    "\n",
    "\n",
    "def evaluate_equilibrium(p1,p2,par,do_print=False):\n",
    "    \n",
    "    # Optimal firm behavior\n",
    "    l1_star,y1_star,pi1_star=firm1(p1,par)\n",
    "    l2_star,y2_star,pi2_star=firm2(p2,par)\n",
    "    pi_star=pi1_star+pi2_star\n",
    "\n",
    "    # Optimal consumer behavior\n",
    "    l_star,c1_star,c2_star = optimal_l(p1,p2,pi_star,par)\n",
    "\n",
    "    # Market clearing\n",
    "    good1_clearing = c1_star-y1_star\n",
    "    good2_clearing = c2_star-y2_star\n",
    "    labor_market_clearing = l_star-(l1_star+l2_star)\n",
    "\n",
    "    if do_print is True:\n",
    "        print(f'for p1={p1:.2f}, p2={p2:.2f}, errors are good1: {good1_clearing}, good2: {good2_clearing}, labor market: {labor_market_clearing}')\n",
    "\n",
    "    return np.abs(good1_clearing)+np.abs(labor_market_clearing)"
   ]
